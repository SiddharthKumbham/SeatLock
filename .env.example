# Copy to .env and choose a local development password.
POSTGRES_USER=seatlock
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=seatlock
POSTGRES_PORT=5432
DATABASE_URL=postgresql://seatlock:replace-with-a-local-password@localhost:5432/seatlock
DATABASE_SSL_MODE=disable
# DATABASE_CA_CERT=PEM-certificate-if-using-verify-full
PORT=4000
FRONTEND_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
DEMO_MODE=false
